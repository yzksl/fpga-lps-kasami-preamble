set_global_assignment -name IP_TOOL_NAME "FIFO"
set_global_assignment -name IP_TOOL_VERSION "24.1"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{Cyclone IV E}"
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "fifo_8bit_4096.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "fifo_8bit_4096_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "fifo_8bit_4096.cmp"]
